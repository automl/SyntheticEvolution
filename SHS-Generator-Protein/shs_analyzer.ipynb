    "# SHS generation + analysis"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Sequence & structure\n",
    "PROTEIN_SEQ = \"ACDEFGHIKLMNPQRSTVWYACDEFGHIKLMNPQRSTVWY\"\n",
    "PAIRS = \"[[0, 3, 0.4], [5, 6, 1], [7, 12, 0.4], [13, 14, 1], [15, 16, 0.4], [17, 18, 1], [19, 20, 0.4]]\"  # residue-index contact pairs\n",
    "MUTATION_RATES = None\n",
    "\n",
    "# MSA size / reproducibility\n",
    "N = 1000\n",
    "SEED = 42\n",
    "\n",
    "# Mutation parameters\n",
    "MUTATION_RATE_PAIRED = 0.3\n",
    "MUTATION_RATE_UNPAIRED = 0.1\n",
    "PAIR_MUTATION_APPROACH = \"covariance\"  # covariance | none\n",
    "\n",
    "# insertions / deletions - paired\n",
    "STEM_SINGLE_INSERTION_PROB  = 0.05\n",
    "STEM_LONG_INSERTION_PROB    = 0.01\n",
    "STEM_SINGLE_DELETION_PROB   = 0.1\n",
    "STEM_PAIR_DELETION_PROB     = 0.2\n",
    "STEM_MAX_INSERTION_FRACTION = 0.2\n",
    "\n",
    "# insertions / deletions - unpaired\n",
    "LOOP_SINGLE_INSERTION_PROB = 0.1\n",
    "LOOP_SINGLE_DELETION_PROB  = 0.3\n",
    "LOOP_LONG_INSERTION_PROB   = 0.1\n",
    "LOOP_LONG_DELETION_PROB    = 0.05\n",
    "LOOP_MAX_INSERTION_FRACTION = 0.2\n",
    "LOOP_MAX_DELETION_FRACTION  = 0.1\n"
   ]
