   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Generate the SHS"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "structure_input = shs_generator.parse_json(PAIRS) if isinstance(PAIRS, str) else PAIRS\n",
    "per_position_rates = shs_generator.parse_json(MUTATION_RATES) if isinstance(MUTATION_RATES, str) else MUTATION_RATES\n",
    "pair_map = generator_config.build_pair_map(\n",
    "    PROTEIN_SEQ, structure_input,\n",
    "    mutation_rate_paired=MUTATION_RATE_PAIRED,\n",
    "    mutation_rate_unpaired=MUTATION_RATE_UNPAIRED,\n",
    "    mutation_rates=per_position_rates,\n",
    ")\n",
    "\n",
    "# Only global algorithm settings belong in MutationParameters.\n",
    "parameters = generator_config.MutationParameters(\n",
    "    N=N,\n",
    "    pair_mutation_approach=PAIR_MUTATION_APPROACH,\n",
    "    stem_single_insertion_prob=STEM_SINGLE_INSERTION_PROB,\n",
    "    stem_long_insertion_prob=STEM_LONG_INSERTION_PROB,\n",
    "    stem_single_deletion_prob=STEM_SINGLE_DELETION_PROB,\n",
    "    stem_pair_deletion_prob=STEM_PAIR_DELETION_PROB,\n",
    "    stem_max_insertion_fraction=STEM_MAX_INSERTION_FRACTION,\n",
    "    loop_single_insertion_prob=LOOP_SINGLE_INSERTION_PROB,\n",
    "    loop_single_deletion_prob=LOOP_SINGLE_DELETION_PROB,\n",
    "    loop_long_insertion_prob=LOOP_LONG_INSERTION_PROB,\n",
    "    loop_long_deletion_prob=LOOP_LONG_DELETION_PROB,\n",
    "    loop_max_insertion_fraction=LOOP_MAX_INSERTION_FRACTION,\n",
    "    loop_max_deletion_fraction=LOOP_MAX_DELETION_FRACTION,\n",
    ")\n",
    "generator = shs_generator.MsaGenerator(parameters, seed=SEED)\n",
    "msa = generator.generate(PROTEIN_SEQ, pair_map)\n",
    "\n",
    "# JSON construction is separate from generation. This notebook does not save it.\n",
    "generated_json = json_generator.build_input_json(\n",
    "    PROTEIN_SEQ, msa, name=\"notebook_protein\", model_seeds=[1],\n",
    ")\n",
    "print(\"Generated\", len(msa), \"MSA rows for\", len(PROTEIN_SEQ), \"residues\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Analyze & render"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import json\n",
    "import numpy as np\n",
    "\n",
    "data = shs_analyzer.MsaData.from_text(json.dumps(generated_json), pairs=pair_map)\n",
    "feat = shs_analyzer.Features(data)\n",
    "\n",
    "print(f\"Query length: {len(data.seq)}  \"\n",
    "   f\"|  MSA rows: {data.aligned.shape[0] + 1}  \"\n",
    "   f\"|  covariance shape: {feat.covariance.shape}\")\n",
    "\n",
    "print(data.seq)\n",
    "for row in data.raw[:10]:\n",
    "    print(\"\".join(row))\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Covariance per pair"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "_ = shs_analyzer.plot_covariance_classification(data.seq, feat.covariance, pairs=data.pairs)\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Deletion and Insertion analysis"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "_ = shs_analyzer.plot_deletions_and_insertion(feat.col_deletion_rate, feat.col_insertion_mean, pairs=data.pairs)\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Mutation-rate comparison"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# PairMap stores the effective rates, including scalar defaults and overrides.\n",
    "input_rates = np.array([pair_map.mutation_rate(i) for i in range(len(data.seq))])\n",
    "output_rates = feat.col_mut_rate\n",
    "fig, metrics = shs_analyzer.plot_mutation_rate_comparison(input_rates, output_rates)\n",
    "print(f\"MAE: {metrics['mae']:.4f} | RMSE: {metrics['rmse']:.4f} | Pearson r: {metrics['pearson_r']:.4f}\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Recovered parameters"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "\n",
    "# Show full cell contents so the `detail` strings aren't truncated.\n",
    "pd.set_option(\"display.max_colwidth\", None)\n",
    "pd.set_option(\"display.width\", None)\n",
    "\n",
    "# Known generator input per recovered parameter name (the ground truth each\n",
    "# estimator tries to reproduce). Extend this as you add estimators.\n",
    "KNOWN_INPUTS = {\n",
    "    \"n_sequences\":            N,\n",
    "    \"mutation_rate_unpaired\": MUTATION_RATE_UNPAIRED,\n",
    "    \"mutation_rate_paired\":   MUTATION_RATE_PAIRED,\n",
    "}\n",
    "\n",
    "report = shs_analyzer.analyze_data(data)\n",
    "\n",
    "\n",
    "def _fmt_detail(detail):\n",
    "    # Turn {'unpaired_cols': 14, ...} into a readable \"unpaired_cols=14 \u00b7 ...\" line.\n",
    "    return \" \u00b7 \".join(f\"{k}={v}\" for k, v in detail.items())\n",
    "\n",
    "\n",
    "rows = []\n",
    "for name, est in report.items():\n",
    "    known = KNOWN_INPUTS.get(name)\n",
    "    # est.value != est.value is True only for NaN -> no error there.\n",
    "    error = abs(est.value - known) if (known is not None and est.value == est.value) else None\n",
    "    rows.append({\n",
    "        \"parameter\": name,\n",
    "        \"known\":     known,\n",
    "        \"recovered\": round(est.value, 4),\n",
    "        \"abs_error\": round(error, 4) if error is not None else None,\n",
    "        \"detail\":    _fmt_detail(est.detail),\n",
    "    })\n",
    "\n",
    "pd.DataFrame(rows).set_index(\"parameter\")\n"
   ]
  }
