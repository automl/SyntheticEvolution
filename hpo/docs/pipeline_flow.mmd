end

subgraph GpuNode["GPU allocation"]
    subgraph Step2["Step 2: AF3"]
        AF3Slurm["hpo/pipeline/slurm/af3-inference-array.slurm"]
        AF3Task["hpo/pipeline/af3_task.py"]
        AF3[/"AlphaFold 3"/]
    end
end

Workspace[("Workspace")]

%% Three login-node execution paths.
User -.- SubmitStandalone & SubmitNeps & Export
SubmitNeps --> RunNeps
SubmitNeps --"sbatch"--> CpuNode
SubmitStandalone --> RunStandalone
SubmitStandalone --"sbatch"--> CpuNode

%% Controller startup and trial ownership.
RunStandalone --> Trial
RunNeps --> NePS --"for every sampled config"--> Trial
Trial -."aggregated loss".-> NePS

%% trial.py executes the four stages in order.
Trial --"1"--> SHSGenerator 
Trial --"2"--> AF3Slurm
Trial --"2 sbatch"--> GpuNode
Trial --"3"--> DSSR 
Trial --"4"--> Scoring
%% Step 1
%% Step 2
AF3Slurm --> AF3Task --> AF3
%% Step 3
DSSR --> DSSRTool
%% Step 4
Scoring -."loss".-> Trial

%% Workspace access 
SHSGenerator -."save af3 input".- Workspace
Trial -."save results".- Workspace
AF3 -."read af3 input\n save predicted model".- Workspace
DSSRTool -."save predicted pairs".- Workspace
Export -."read results".- Workspace

