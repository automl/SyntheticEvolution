Workspace[("Workspace")]

%% Three login-node execution paths.
User -.- SubmitStandalone & SubmitNeps & Export
SubmitNeps --> RunNeps & Slurm
SubmitStandalone --> RunStandalone & Slurm
Slurm --"sbatch"--> CpuNode

%% Controller startup and trial ownership.
RunStandalone --> Trial
RunNeps --> NePS --"for every sampled config"--> Trial
Trial -."aggregated loss".-> NePS

%% trial.py executes the four stages in order.
Trial --"1"--> SHSGenerator 
Trial --"2"--> AF3Task
Trial --"3"--> DSSR 
Trial --"4"--> Scoring
%% Step 1
%% Step 2
AF3Task --> AF3
%% Step 3
DSSR --> DSSRTool
%% Step 4
Scoring -."loss".-> Trial

%% Tools work in scratch; only the trial writes to the workspace.
SHSGenerator -."af3 input, log".- Scratch
AF3 -."predictions, log".- Scratch
DSSRTool -."dssr.json, side files, log".- Scratch
Trial -."per-RNA archives, trial record,\nfailure report, retention".- Workspace
Export -."read results, --prune".- Workspace

